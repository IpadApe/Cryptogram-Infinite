<?xml version="1.0" encoding="utf-8"?>
<!--
   Everything is backed up / transferred except the autosave database
   (design doc section 9): an in-progress puzzle must never restore onto
   another device or a reinstall.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="in_progress.db" />
        <exclude domain="database" path="in_progress.db-wal" />
        <exclude domain="database" path="in_progress.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="in_progress.db" />
        <exclude domain="database" path="in_progress.db-wal" />
        <exclude domain="database" path="in_progress.db-shm" />
    </device-transfer>
</data-extraction-rules>
